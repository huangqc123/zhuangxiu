.sheet-title { font-size: 35rpx; }
.sheet-note { font-size: 23rpx; }
.field-cell { display: flex; flex-direction: column; min-height: 204rpx; padding: 22rpx 19rpx 18rpx; }
.field-cell:last-child:nth-child(odd) { grid-column: 1 / -1; }
.field-label { font-size: 28rpx; line-height: 38rpx; }
.field-order { font-size: 20rpx; }
.field-note { height: 31rpx; font-size: 22rpx; line-height: 31rpx; }
.field-entry { min-height: 68rpx; margin-top: auto; padding: 3rpx 11rpx; border: 1rpx solid #D5CCBE; border-bottom: 3rpx solid #968C7E; background: #FFFDF8; }
.field-input { height: 60rpx; font-size: 38rpx; }
.field-unit { margin-bottom: 8rpx; font-size: 22rpx; }
.field-error-text { bottom: 0; font-size: 19rpx; }
.advanced-no { font-size: 23rpx; }
.advanced-title { font-size: 29rpx; }
.advanced-desc { font-size: 22rpx; }
.advanced-state { font-size: 25rpx; }
.reset-button, .calculate-button { height: 100rpx; font-size: 28rpx; }
.method-link { font-size: 24rpx; }
.result-kicker { font-size: 20rpx; letter-spacing: 1rpx; }
.result-title { font-size: 31rpx; }
.result-tool { font-size: 24rpx; }
.result-primary-label { font-size: 27rpx; }
.result-primary-hint { font-size: 22rpx; }
.result-primary-unit { font-size: 26rpx; }
.purchase-head { font-size: 24rpx; }
.purchase-index { font-size: 21rpx; }
.purchase-name { font-size: 27rpx; }
.purchase-detail { font-size: 22rpx; }
.purchase-value { font-size: 35rpx; }
.purchase-unit { font-size: 22rpx; }
.budget-kicker { font-size: 20rpx; letter-spacing: 0; }
.budget-title { font-size: 30rpx; }
.budget-desc { font-size: 22rpx; }
.budget-total-preview { font-size: 26rpx; }
.budget-line-name { font-size: 24rpx; }
.budget-line-qty { font-size: 21rpx; }
.currency, .subtotal { font-size: 22rpx; }
.price-control input { font-size: 26rpx; }
.price-unit { font-size: 20rpx; }
.budget-sum { font-size: 25rpx; }
.budget-note { font-size: 21rpx; line-height: 32rpx; }
.metric-label { font-size: 22rpx; }
.metric-value { font-size: 33rpx; }
.metric-unit { font-size: 21rpx; }
.audit-head { font-size: 29rpx; }
.audit-head text:last-child { font-family: inherit; font-size: 21rpx; letter-spacing: 0; }
.audit-line, .assumption-line { font-size: 23rpx; line-height: 36rpx; }
.warning-title { font-size: 27rpx; }
.warning-line { font-size: 23rpx; line-height: 35rpx; }
.result-disclaimer { font-size: 22rpx; line-height: 34rpx; }

.sheet-note, .field-note, .field-unit, .method-link, .purchase-detail, .budget-desc, .budget-note, .metric-label, .result-disclaimer { color: #665F55; }
.field-cell { min-height: 224rpx; }
.field-note { height: auto; min-height: 31rpx; overflow: visible; text-overflow: clip; white-space: normal; }
.cover-favorite { min-width: 64rpx; min-height: 64rpx; }

/* 记录命名与排布方案 */
.record-name-sheet { display: grid; grid-template-columns: 1fr 250rpx; align-items: center; gap: 18rpx; margin-top: 20rpx; padding: 24rpx; border: 1rpx solid #D7CDBF; background: #FFFDF8; box-shadow: 5rpx 6rpx 0 #DED6CA; }
.record-name-copy text { display: block; }
.record-name-title { color: #393733; font-size: 28rpx; font-weight: 760; }
.record-name-desc { margin-top: 5rpx; color: #665F55; font-size: 22rpx; line-height: 34rpx; }
.record-name-sheet input { height: 66rpx; padding: 0 15rpx; border: 1rpx solid #CFC4B5; border-bottom: 3rpx solid #9A8F80; color: #2D2D29; background: #F8F3EB; font-size: 27rpx; }
.layout-sheet { margin-top: 20rpx; padding: 24rpx; border: 1rpx solid #D4CABD; background: #F9F5EE; box-shadow: 5rpx 6rpx 0 #DDD4C7; }
.layout-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 15rpx; border-bottom: 2rpx solid #36332E; }
.layout-head text:first-child { font-size: 29rpx; font-weight: 780; }
.layout-head text:last-child { color: #665F55; font-size: 22rpx; }
.layout-plans { margin-top: 4rpx; }
.layout-plan { display: grid; grid-template-columns: 1fr auto; align-items: center; min-height: 96rpx; padding: 13rpx 0; border-bottom: 1rpx dashed #D5CABC; }
.layout-plan:last-child { border-bottom: 0; }
.layout-plan-copy text { display: block; }
.layout-plan-copy > text:first-child { color: #35322E; font-size: 27rpx; font-weight: 740; }
.layout-plan-copy > text:last-child { margin-top: 5rpx; color: #665F55; font-size: 23rpx; }
.layout-plan-result { min-width: 160rpx; margin-left: 18rpx; text-align: right; }
.layout-plan-result > text:first-child { display: block; color: #2D2D29; font-family: monospace; font-size: 31rpx; font-weight: 820; }
.layout-plan-result > text:last-child { display: inline-flex; align-items: center; justify-content: center; min-height: 68rpx; margin-top: 3rpx; padding: 0 15rpx; color: #A85037; font-size: 24rpx; font-weight: 700; }
.layout-plan.selected .layout-plan-result > text:last-child { color: #176B5B; }

/* 图标视觉尺寸不变，扩大实际触控区域 */
.cover-favorite { width: 80rpx; height: 80rpx; margin: -8rpx 0 -8rpx 2rpx; border-color: transparent; }
.cover-favorite::before { content: ''; position: absolute; inset: 11rpx; border: 1rpx solid rgba(255,255,255,.28); }
.cover-favorite.active { border-color: transparent; background: transparent; }
.cover-favorite.active::before { border-color: rgba(243,200,106,.65); background: rgba(243,200,106,.08); }
.method-link { display: flex; align-items: center; justify-content: center; min-height: 80rpx; padding: 10rpx 0 0; }
