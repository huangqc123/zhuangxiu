.advanced-arrow {
  position: relative;
  display: block;
  flex: 0 0 auto;
  width: 18rpx;
  height: 12rpx;
  margin-left: 12rpx;
  transition: transform .2s;
}
.advanced-arrow::before,
.advanced-arrow::after {
  position: absolute;
  top: 4rpx;
  width: 11rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: currentColor;
  content: '';
}
.advanced-arrow::before { left: 0; transform: rotate(45deg); }
.advanced-arrow::after { right: 0; transform: rotate(-45deg); }
.advanced-arrow.up { transform: rotate(180deg); }
.advanced-grid { border-top: 0; box-shadow: none; }
