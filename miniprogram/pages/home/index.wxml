<view class="home-page">
  <view class="cover">
    <view class="cover-lines"></view>
    <view class="cover-header">
      <text>装修材料计算工作簿</text>
    </view>
    <view class="cover-body">
      <view class="cover-copy">
        <text class="cover-kicker">装修前，先把量算清楚</text>
        <text class="cover-title">装修算料</text>
        <text class="cover-title outline">工作簿</text>
        <text class="cover-desc">从现场尺寸到采购数量，每一步都有清楚口径。</text>
      </view>
      <view class="sample-board">
        <view class="sample-grid"></view>
        <view class="sample-room">
          <view class="sample-door"></view>
          <view class="sample-tile tile-one"></view>
          <view class="sample-tile tile-two"></view>
          <view class="sample-tile tile-three"></view>
          <view class="sample-tile tile-four"></view>
        </view>
        <view class="sample-label"><text>{{toolCount}}</text><text>项工具</text></view>
        <view class="sample-pin"></view>
      </view>
    </view>
  </view>

  <view class="home-content">
    <view class="search-box">
      <text class="search-symbol">⌕</text>
      <input value="{{query}}" placeholder="搜索地砖、防水、砂浆……" placeholder-class="search-placeholder" confirm-type="search" cursor-spacing="24" aria-label="搜索材料计算工具" bindinput="onSearchInput" />
      <text wx:if="{{query}}" class="search-clear" aria-role="button" aria-label="清除搜索内容" bindtap="onClearSearch">清除</text>
    </view>

    <block wx:if="{{query}}">
      <view class="catalog-heading">
        <view><text class="catalog-index">搜索</text><text class="catalog-title">搜索结果</text></view>
        <text class="catalog-count">{{searchResults.length}} 项</text>
      </view>
      <view wx:if="{{searchResults.length}}" class="tool-grid">
        <view wx:for="{{searchResults}}" wx:key="id" class="tool-tile" data-id="{{item.id}}" aria-role="button" aria-label="打开{{item.name}}" bindtap="onToolTap">
          <view class="tool-top"><view class="tool-glyph" style="color: {{item.accent}}; background: {{item.softColor}};">{{item.icon}}</view><view class="star {{item.favorite ? 'active' : ''}}" data-id="{{item.id}}" aria-role="button" aria-label="{{item.favorite ? '取消常用' : '加入常用'}}" catchtap="onToggleFavorite">{{item.favorite ? '★' : '☆'}}</view></view>
          <text class="tool-name">{{item.name}}</text>
          <text class="tool-desc">{{item.subtitle}}</text>
          <view class="tool-link"><text>打开工具</text><text>→</text></view>
        </view>
      </view>
      <view wx:else class="empty-search"><text>没有找到相关工具</text><text>试试“砖”“漆”“砂浆”等关键词</text></view>
    </block>

    <block wx:else>
      <view wx:if="{{favoriteTools.length}}">
        <view class="catalog-heading compact">
          <view><text class="catalog-index">常用</text><text class="catalog-title">常用工具</text></view>
          <text class="catalog-count">{{favoriteTools.length}} 项</text>
        </view>
        <scroll-view class="favorite-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="favorite-track">
            <view wx:for="{{favoriteTools}}" wx:key="id" class="favorite-sample" data-id="{{item.id}}" aria-role="button" aria-label="打开{{item.name}}" bindtap="onToolTap" style="border-top-color: {{item.accent}};">
              <view class="favorite-glyph" style="color: {{item.accent}};">{{item.icon}}</view>
              <text>{{item.name}}</text>
              <text class="favorite-open">打开工具 ↗</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <block wx:for="{{sections}}" wx:key="id" wx:for-item="section" wx:for-index="sectionIndex">
        <view class="catalog-heading">
          <view><text class="catalog-index">0{{sectionIndex + 1}} / {{section.shortName}}</text><text class="catalog-title">{{section.name}}</text></view>
          <text class="catalog-count">{{section.tools.length}} 项</text>
        </view>
        <view class="tool-grid">
          <view wx:for="{{section.tools}}" wx:key="id" class="tool-tile" data-id="{{item.id}}" aria-role="button" aria-label="打开{{item.name}}" bindtap="onToolTap">
            <view class="tool-top"><view class="tool-glyph" style="color: {{item.accent}}; background: {{item.softColor}};">{{item.icon}}</view><view class="star {{item.favorite ? 'active' : ''}}" data-id="{{item.id}}" aria-role="button" aria-label="{{item.favorite ? '取消常用' : '加入常用'}}" catchtap="onToggleFavorite">{{item.favorite ? '★' : '☆'}}</view></view>
            <text class="tool-name">{{item.name}}</text>
            <text class="tool-desc">{{item.subtitle}}</text>
            <view class="tool-link"><text>打开工具</text><text>→</text></view>
          </view>
        </view>
      </block>

      <view wx:if="{{recent.length}}">
        <view class="catalog-heading">
          <view><text class="catalog-index">最近</text><text class="catalog-title">最近计算</text></view>
          <text class="catalog-count" bindtap="onOpenHistory">全部 ↗</text>
        </view>
        <view class="recent-ledger">
          <view wx:for="{{recent}}" wx:key="id" class="ledger-row" data-id="{{item.id}}" data-type="{{item.toolId}}" bindtap="onOpenRecord">
            <text class="ledger-no">0{{index + 1}}</text>
            <view class="ledger-info"><text>{{item.displayName}}</text><text>{{item.subtitleText}}</text></view>
            <text class="ledger-result">{{item.primary.value}} {{item.primary.unit}}</text>
            <text class="ledger-arrow">↗</text>
          </view>
        </view>
      </view>
    </block>

    <view class="home-footer">
      <text>量准再买，少补少退</text>
      <text>纯前端计算，参数不会上传</text>
    </view>
  </view>
</view>
